{
  "name": "sidorovich",
  "version": "0.1.0",
  "private": true,
  "description": "Test de personnalité S.T.A.L.K.E.R. : quelle faction de la Zone est faite pour toi ? Projet de fan non officiel.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run validate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "tsx scripts/validate-data.ts",
    "calibrate": "tsx scripts/calibrate.ts",
    "balance": "tsx scripts/balance-report.ts",
    "docs:questionnaire": "tsx scripts/gen-questionnaire-doc.ts",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run validate && npm run test:coverage",
    "test:e2e": "playwright test",
    "icons": "node scripts/generate-icons.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "demo": "node scripts/record-demo.mjs"
  },
  "dependencies": {
    "next": "16.4.6",
    "next-intl": "^4.15.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "fast-check": "^4.10.2",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "@swc/core": false,
    "esbuild": false
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
